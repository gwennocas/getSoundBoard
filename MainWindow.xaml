<Window
    x:Class="GetSoundBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="getSoundBoard">

    <Grid x:Name="Root" Background="#11141C" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#191E29" Padding="28,22" BorderBrush="#2A3040" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#7276FF">
                        <TextBlock Text="♫" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="getSoundBoard" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Seus sons, no momento certo." FontSize="12" Foreground="#A9B0C0" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="StopButton" Content="■  Parar tudo  ·  Ctrl+Alt+Backspace" Click="StopButton_Click" Background="#3A2630" Foreground="#FFD8E1" Padding="18,10" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabView x:Name="MainTabView" Grid.Row="1" IsAddTabButtonVisible="False" SelectionChanged="MainTabView_SelectionChanged">
          <TabViewItem x:Name="SoundboardTab" Header="Soundboard" IsClosable="False">
          <Grid Background="#11141C">
          <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Padding="28,26,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="Sua biblioteca" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Clique ou use um atalho enquanto joga. Solte arquivos de áudio aqui para importar (MP3, WAV, OGG/Opus, FLAC e outros)." TextWrapping="Wrap" Foreground="#A9B0C0" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,23,0,18" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Buscar um som..." TextChanged="SearchBox_TextChanged" MinWidth="180" />
                <Button Grid.Column="1" x:Name="ImportButton" Content="+  Adicionar áudios" Click="ImportButton_Click" Background="#7276FF" Foreground="White" Padding="18,10" />
            </Grid>
            <Grid Grid.Row="2">
                <GridView x:Name="SoundGrid" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="218" Height="160" Margin="0,0,12,12" Padding="16" CornerRadius="15" Background="#222838" BorderBrush="#333B50" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" MaxLines="2" />
                                    <TextBlock Grid.Row="1" Text="{Binding Hotkey}" Foreground="#ADB5CA" FontSize="12" Margin="0,0,0,11" />
                                    <Grid Grid.Row="2" ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="▶  Tocar" Tag="{Binding Id}" Click="PlayClip_Click" Background="#4146A5" Foreground="White" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="✎" ToolTipService.ToolTip="Editar" Tag="{Binding Id}" Click="EditClip_Click" />
                                        <Button Grid.Column="2" Content="×" ToolTipService.ToolTip="Excluir" Tag="{Binding Id}" Click="DeleteClip_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="♪" FontSize="58" Foreground="#7276FF" HorizontalAlignment="Center" />
                    <TextBlock Text="Sua biblioteca começa aqui" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Adicione um áudio compatível para criar o primeiro botão." Foreground="#A9B0C0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="#191E29" BorderBrush="#2A3040" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24,28" Spacing="12">
                    <TextBlock Text="Configuração de áudio" FontSize="21" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Escolha sua voz, onde você ouve os sons e o cabo virtual que envia tudo ao chat." Foreground="#A9B0C0" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Border x:Name="FirstRunHint" Background="#2B3156" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Configurar o VB-CABLE (uma vez)" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="1. Baixe o ZIP oficial abaixo e extraia os arquivos.&#x0a;2. Clique com o botão direito no instalador x64 e escolha Executar como administrador. Permita a instalação do driver.&#x0a;3. Reinicie o Windows.&#x0a;4. Abra o app e clique em Atualizar dispositivos. O VB-CABLE será selecionado automaticamente." Foreground="#E7E8FF" TextWrapping="Wrap" />
                            <HyperlinkButton Content="Baixar ZIP oficial do VB-Audio ↗" Click="CableLink_Click" Padding="0,2" HorizontalAlignment="Left" />
                            <TextBlock Text="O VB-CABLE é um produto VB-Audio no modelo donationware. Veja vb-cable.com para conhecer e apoiar o projeto." Foreground="#C4C8DB" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Seu microfone" Foreground="#D8DEEA" Margin="0,12,0,0" />
                    <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id" PlaceholderText="Escolha o microfone" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Seus alto-falantes ou fone" Foreground="#D8DEEA" Margin="0,7,0,0" />
                    <ComboBox x:Name="SpeakerBox" DisplayMemberPath="Name" SelectedValuePath="Id" PlaceholderText="Escolha onde ouvir" HorizontalAlignment="Stretch" />
                    <TextBlock Text="VB-CABLE Input" Foreground="#D8DEEA" Margin="0,7,0,0" />
                    <ComboBox x:Name="CableBox" DisplayMemberPath="Name" SelectedValuePath="Id" PlaceholderText="Escolha o cabo virtual" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Se instalado, o VB-CABLE é selecionado automaticamente." Foreground="#929BAE" TextWrapping="Wrap" />
                    <HyperlinkButton Content="Baixar novamente o ZIP oficial ↗" Click="CableLink_Click" Padding="0,4" HorizontalAlignment="Left" />
                    <TextBlock Text="No Discord/jogo, selecione CABLE Output como microfone." Foreground="#A9B0C0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,7">
                        <Button Content="Atualizar dispositivos" Click="RefreshDevices_Click" />
                        <Button Content="Aplicar" Click="ApplyAudio_Click" Background="#7276FF" Foreground="White" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="#343B4D" Margin="0,12" />
                    <TextBlock Text="Volume dos sons" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Nos seus alto-falantes" Foreground="#D8DEEA" />
                        <TextBlock x:Name="SpeakerPercentText" Text="35%" Foreground="#ADB5CA" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="SpeakerVolumeSlider" Minimum="0" Maximum="100" Value="35" ValueChanged="VolumeSlider_ValueChanged" />
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="Sons junto à sua voz" Foreground="#D8DEEA" />
                        <TextBlock x:Name="MicPercentText" Text="70%" Foreground="#ADB5CA" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="−" Width="38" Padding="0" Click="MicVolumeDown_Click" AutomationProperties.Name="Diminuir volume dos sons junto à voz" />
                        <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Volume dos sons junto à voz" />
                        <Button Grid.Column="2" Content="+" Width="38" Padding="0" Click="MicVolumeUp_Click" AutomationProperties.Name="Aumentar volume dos sons junto à voz" />
                    </Grid>
                    <TextBlock Text="Sua voz mantém o volume definido no Windows. Ela não é reproduzida no seu fone pelo app." Foreground="#929BAE" TextWrapping="Wrap" Margin="0,9,0,0" />
                    <TextBlock Text="Ao minimizar ou fechar, o app continua na área de notificação. Clique duas vezes no ícone para reabrir." Foreground="#929BAE" TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
          </Grid>
          </TabViewItem>
          <TabViewItem x:Name="UpdatesTab" Header="Atualizações" IsClosable="False">
            <Grid Background="#11141C" Padding="28,26">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Spacing="6">
                <TextBlock Text="Atualizações" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Confira o que mudou e escolha qual versão do getSoundBoard baixar." TextWrapping="Wrap" Foreground="#A9B0C0" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,20,0,10">
                <TextBlock x:Name="CurrentVersionText" Foreground="#D8DEEA" VerticalAlignment="Center" />
                <Button x:Name="CheckUpdatesButton" Content="↻  Verificar atualizações" Click="CheckUpdates_Click" Background="#7276FF" Foreground="White" Padding="16,9" HorizontalAlignment="Right" />
              </Grid>
              <TextBlock x:Name="UpdateStatusText" Grid.Row="2" Text="Clique em Verificar atualizações para consultar as versões publicadas." Foreground="#A9B0C0" TextWrapping="Wrap" Margin="0,0,0,10" />
              <Grid Grid.Row="3">
                <ListView x:Name="ReleaseList" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,12" Padding="18" CornerRadius="14" Background="#222838" BorderBrush="#333B50" BorderThickness="1">
                        <Grid ColumnSpacing="18">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Version}" FontSize="20" FontWeight="Bold" Foreground="White" />
                              <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="#BFC3FF" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding PublishedAt}" FontSize="12" Foreground="#ADB5CA" />
                            <TextBlock Text="{Binding Notes}" Foreground="#D8DEEA" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="{Binding DownloadButtonText}" Tag="{Binding DownloadUrl}" Click="DownloadRelease_Click" Background="#4146A5" Foreground="White" Padding="16,10" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="NoReleasesState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                  <TextBlock Text="Nenhuma versão encontrada" FontSize="19" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                  <TextBlock Text="Tente verificar novamente mais tarde." Foreground="#A9B0C0" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressRing x:Name="UpdatesLoadingRing" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </TabViewItem>
        </TabView>

        <Border Grid.Row="2" Background="#191E29" BorderBrush="#2A3040" BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock x:Name="StatusText" Text="Pronto para configurar o áudio." Foreground="#A9B0C0" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
